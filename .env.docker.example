# TaskPlanner con Docker Compose — copia in .env e compila i valori.
# Genera i segreti con: openssl rand -hex 32

# Obbligatorie
SECRET_KEY=
# Solo lettere e cifre (finisce dentro un URL di connessione)
POSTGRES_PASSWORD=

# Porta e indirizzo pubblicati sull'host. 127.0.0.1 = raggiungibile solo dal
# server stesso (es. dietro un reverse proxy); 0.0.0.0 = da tutta la rete.
# TASKPLANNER_BIND=127.0.0.1
# TASKPLANNER_PORT=8000

# Login con username e password (default true con Docker).
# Gli account si creano con: docker compose exec app python -m server.manage create-user <username>
# LOCAL_AUTH=true

# Google OAuth, opzionale (in aggiunta o al posto delle password).
# Il redirect URI da autorizzare è <APP_BASE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_BASE_URL=https://tasks.example.com

# Opzionali
# TZ_NAME=Europe/Rome
# PRIVACY_CONTACT_EMAIL=
# Licenza AGPL-3.0: se offri una versione modificata, punta al TUO repository
# TASKPLANNER_SOURCE_URL=https://github.com/doofie46-a11y/taskplanner
