# TaskPlanner con Docker Compose — copia in .env e compila i valori.
# Genera i segreti con: openssl rand -hex 32

# Obbligatorie
SECRET_KEY=
# Solo lettere e cifre (finisce dentro un URL di connessione)
POSTGRES_PASSWORD=

# Versione dell'immagine (default latest). Per restare su una versione: TASKPLANNER_VERSION=1.6.0
# TASKPLANNER_VERSION=latest

# Porta e indirizzo pubblicati sull'host. 127.0.0.1 = raggiungibile solo dal
# server stesso (es. dietro un reverse proxy); 0.0.0.0 = da tutta la rete.
# TASKPLANNER_BIND=127.0.0.1
# TASKPLANNER_PORT=8000

# Login con username e password (default true con Docker).
# Gli account si creano con: docker compose exec app python -m server.manage create-user <username>
# LOCAL_AUTH=true

# Google OAuth, opzionale (in aggiunta o al posto delle password).
# Il redirect URI da autorizzare è <APP_BASE_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_BASE_URL=https://tasks.example.com

# Cloudflare Access, opzionale (con Access su tutto il dominio conviene LOCAL_AUTH=false): Access sta davanti all'app e TaskPlanner verifica il JWT che
# Cloudflare allega a ogni richiesta. Servono entrambe:
#   CF_ACCESS_TEAM_DOMAIN: Zero Trust → Settings → Team domain (<team>.cloudflareaccess.com)
#   CF_ACCESS_AUD: Application Audience (AUD) tag dell'applicazione Access (più valori separati da virgola)
# Applicazione Access su tutto il dominio = login automatico; solo sul path /auth/cloudflare =
# pulsante «Accedi con Cloudflare» nella pagina di login. In entrambi i casi aggiungere una policy
# Bypass per /api/tasks e /add_from_mail (usano le chiavi API, non il login).
# Chi può entrare lo decide la policy di Access; l'account viene creato al primo accesso
# (CF_ACCESS_AUTO_CREATE=false per accettare solo email di account già esistenti).
# CF_ACCESS_TEAM_DOMAIN=mioteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# CF_ACCESS_AUTO_CREATE=true

# Opzionali
# TZ_NAME=Europe/Rome
# PRIVACY_CONTACT_EMAIL=
# Licenza AGPL-3.0: se offri una versione modificata, punta al TUO repository
# TASKPLANNER_SOURCE_URL=https://github.com/doofie46-a11y/taskplanner
