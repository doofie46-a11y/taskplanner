# TaskPlanner (modalità server) — variabili d'ambiente
# La versione desktop non richiede nessuna di queste variabili.

# Chiave segreta Flask, obbligatoria (genera con: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# PostgreSQL, obbligatoria
DATABASE_URL=postgresql://utente:password@localhost/taskplanner

# Login: Google OAuth, Cloudflare Access, username e password, in qualsiasi combinazione
# (almeno uno è obbligatorio)

# Google OAuth (da Google Cloud Console → APIs & Services → Credentials), opzionale
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Cloudflare Access, opzionale: Access sta davanti all'app e TaskPlanner verifica il JWT che
# Cloudflare allega a ogni richiesta. Servono entrambe:
#   CF_ACCESS_TEAM_DOMAIN: Zero Trust → Settings → Team domain (<team>.cloudflareaccess.com)
#   CF_ACCESS_AUD: Application Audience (AUD) tag dell'applicazione Access (più valori separati da virgola)
# Applicazione Access su tutto il dominio = login automatico; solo sul path /auth/cloudflare =
# pulsante «Accedi con Cloudflare» nella pagina di login. In entrambi i casi aggiungere una policy
# Bypass per /api/tasks e /add_from_mail (usano le chiavi API, non il login).
# Chi può entrare lo decide la policy di Access; l'account viene creato al primo accesso
# (CF_ACCESS_AUTO_CREATE=false per accettare solo email di account già esistenti).
# CF_ACCESS_TEAM_DOMAIN=mioteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# CF_ACCESS_AUTO_CREATE=true

# Login con username e password. Non impostata = attivo solo se né Google né Cloudflare Access
# sono configurati.
# Gli account si creano da riga di comando: python -m server.manage create-user <username>
# LOCAL_AUTH=true

# URL base dell'app (senza trailing slash) — usato per costruire il callback OAuth
APP_BASE_URL=https://example.com

# Email di contatto mostrata nell'informativa privacy (/privacy), opzionale
PRIVACY_CONTACT_EMAIL=

# Timezone (default Europe/Rome), opzionale
TZ_NAME=Europe/Rome

# Link "offrimi un caffè" (vuoto = nascosto), opzionale
# TASKPLANNER_SUPPORT_URL=

# Link "Codice sorgente" in sidebar. Licenza AGPL-3.0: se offri una versione
# modificata, punta al TUO repository con le modifiche.
# TASKPLANNER_SOURCE_URL=https://github.com/doofie46-a11y/taskplanner
