# TaskPlanner (modalità server) — variabili d'ambiente
# La versione desktop non richiede nessuna di queste variabili.

# Chiave segreta Flask, obbligatoria (genera con: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# PostgreSQL, obbligatoria
DATABASE_URL=postgresql://utente:password@localhost/taskplanner

# Google OAuth (da Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# URL base dell'app (senza trailing slash) — usato per costruire il callback OAuth
APP_BASE_URL=https://example.com

# Email di contatto mostrata nell'informativa privacy (/privacy), opzionale
PRIVACY_CONTACT_EMAIL=

# Timezone (default Europe/Rome), opzionale
TZ_NAME=Europe/Rome

# Link "offrimi un caffè" (vuoto = nascosto), opzionale
# TASKPLANNER_SUPPORT_URL=
